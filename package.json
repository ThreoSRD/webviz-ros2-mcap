  "scripts": {
    "bootstrap": "node scripts/bootstrap-local.cjs",
    "install-ci": "node scripts/bootstrap-local.cjs --ci",
    "build": "lerna run build && webpack",
    "watch": "lerna run watch --parallel",
    "clean": "lerna run clean",
    "lerna": "lerna",
    "lint": "eslint . --max-warnings=0 && prettier -l '**/*.css' --ignore-path .eslintignore",
    "lint:fix": "eslint . --fix && prettier --write '**/*.css' --ignore-path .eslintignore",
    "test": "NODE_ENV=test jest --config jest/jest.config.js",
    "link": "lerna link --force-local",
    "storybook": "start-storybook -p 6006 -c stories",
    "build-storybook": "build-storybook -c stories",
    "flow": "flow check --max-workers 2 --temp-dir .cache/flow",
    "flow-typed-rebuild": "rm -rf flow-typed/ && flow-typed install && flow-typed install --rootDir packages/@cruise-automation/hooks && flow-typed install --rootDir packages/@cruise-automation/button && flow-typed install --rootDir packages/@cruise-automation/tooltip && flow-typed install --rootDir packages/regl-worldview",
    "docs-dev": "NODE_OPTIONS='--max-old-space-size=4096' DEV_SERVER=true webpack-dev-server",
    "build-static-webviz": "lerna run build && rm -rf __static_webviz__ && cp -r docs/public/app __static_webviz__ && rm __static_webviz__/index.html && cp packages/webviz-core/public/index.html __static_webviz__/index.html && sed -i -- 's/\\/dist\\/webvizCoreBundle.js/webvizCoreBundle.js/' __static_webviz__/index.html && NODE_ENV=production STATIC_WEBVIZ=true webpack",
    "serve-static-webviz": "node_modules/http-server/bin/http-server __static_webviz__",
    "screenshot": "NODE_ENV=development storycap http://localhost:6006 --serverTimeout 120000 --captureTimeout 35000 --disableCssAnimation --serverCmd \"yarn run storybook\" --viewport \"1001x745\" --parallel 4",
    "screenshot-ci": "npm run screenshot -- --puppeteerLaunchConfig '{\"executablePath\": \"/usr/bin/google-chrome\", \"headless\": true, \"args\":[\"--use-gl=swiftshader\", \"--no-sandbox\",\"--disable-setuid-sandbox\", \"--disable-dev-shm-usage\", \"--headless\", \"--mute-audio\", \"--user-agent=PuppeteerTestingChrome/80.\"]}'",
    "screenshot-proprietary-ci": "npm run screenshot-ci -- --parallel 4",
    "screenshot-local": "npm run screenshot -- --puppeteerLaunchConfig '{\"headless\": true, \"--args\":[\"--user-agent=PuppeteerTestingChrome/80.\"]}' --parallel 4",
    "screenshot-local-debug": "npm run screenshot-local -- --parallel 1 --debug",
    "ci": "npm run install-ci && npm run verify:mcap -- --no-browser",
    "webviz-dev": "NODE_OPTIONS='--max-old-space-size=4096' DEV_SERVER=true WEBVIZ_DEV=true webpack-dev-server",
    "verify:mcap": "node scripts/verify-mcap.cjs",
    "verify:mcap:clean": "node scripts/verify-clean-install.cjs",
    "test:mcap:regression": "npm test -- --runInBand --cacheDirectory=.cache/jest packages/webviz-core/src/dataProviders packages/webviz-core/src/players/RandomAccessPlayer.test.js packages/webviz-core/src/util/binaryObjects packages/webviz-core/src/panels/ThreeDimensionalViz/SceneBuilder packages/webviz-core/src/panels/ThreeDimensionalViz/Transforms packages/webviz-core/src/panels/ThreeDimensionalViz/Layout/WorkerDataRpc.test.js packages/webviz-core/src/components/ReactChartjs packages/webviz-core/src/components/MessagePipeline/index.test.js packages/webviz-core/src/panels/ThreeDimensionalViz/markerTopicSettings.test.js packages/webviz-core/src/panels/ThreeDimensionalViz/TopicSettingsEditor/MarkerArraySettingsEditor.test.js packages/webviz-core/src/panels/ThreeDimensionalViz/TopicTree",
    "test:mcap:helpers": "node --test scripts/mcap-helpers.test.mjs",
    "test:mcap": "npm test -- --runInBand --cacheDirectory=.cache/jest packages/webviz-core/src/dataProviders/McapDataProvider.test.js packages/webviz-core/src/dataProviders/Ros2Scene.test.js",
    "smoke:mcap": "node scripts/smoke-mcap.cjs",
    "smoke:mcap:scene": "node scripts/smoke-ros2-scene.cjs",
    "smoke:mcap:compression": "node scripts/smoke-mcap-compression.cjs",
    "stress:mcap": "node scripts/stress-mcap.cjs",
    "serve-local": "http-server docs/public -a 127.0.0.1 -p 18080 -c-1",
    "release:source": "node scripts/release-source.cjs",
    "test:release": "node --test scripts/release-source.test.cjs"
  },
  "version": "0.1.0-preview.1",
  "description": "Independent Cruise Webviz derivative with local ROS 2 MCAP playback",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15"
  }
}
